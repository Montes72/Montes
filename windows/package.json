{
  "name": "montes-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sounds": "node scripts/gen-sounds.mjs",
    "i18n": "node scripts/check-i18n.mjs",
    "build": "npm run sounds && tsc --noEmit && npm run i18n && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p montes-hook",
    "prebuild": "cargo build --release -p montes-hook",
    "pack": "tauri build --no-bundle && node scripts/pack.mjs",
    "dist": "tauri build --features montes/custom-protocol && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
